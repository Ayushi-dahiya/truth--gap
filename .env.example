# ============================================================
# TruthGap LLM API Configuration
# ============================================================

# 1. Google Gemini API (Recommended - Free Tier Available)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=GOOGLE_API_KEY=your_google_api_key_here

# 2. Groq Cloud API (Optional - Extremely fast, free tier)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. Provider Preference
# Options: "auto" (picks Gemini if key present, else Groq, else mock)
#          "gemini"
#          "groq"
#          "mock" (offline testing without any API key)
PREFERRED_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash